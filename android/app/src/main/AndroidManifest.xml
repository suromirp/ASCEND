<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Back-up door Android aan, als extra vangnet naast de eigen back-up (keuze van de eigenaar,
         2 november 2026; docs/beslissingen/2026-11-01-android-app.md). Alleen de opslag van de
         webview gaat mee: res/xml/backup_rules.xml (Android 11 en ouder) en
         res/xml/data_extraction_rules.xml (Android 12 en nieuwer). -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Snelkoppelingen onder het app-icoon: res/xml/shortcuts.xml. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- De widget "Vandaag" (TodayWidgetProvider.java). -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Trillen in de webview (navigator.vibrate) en bij een melding. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- De automatische back-up schrijft in Documenten/ASCEND (plugin Filesystem,
         docs/beslissingen/2026-11-02-automatische-backup.md). Alleen Android 10 en ouder vragen
         daarvoor toestemming; vanaf Android 11 mag een app zijn eigen bestanden in Documenten zonder.
         requestLegacyExternalStorage hierboven is voor Android 10. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Je locatie (plugin Geolocation, docs/beslissingen/2026-11-02-locatie.md): alleen als je de
         instelling aanzet, en dan alleen je plek van nu. ASCEND vraagt de ruwe plek (coarse); de
         precieze staat erbij omdat de plugin hem verwacht en Android 12 en nieuwer hem als keuze
         toont. Geen achtergrondlocatie. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Meldingen (Android 13 en nieuwer) en de exacte wekker voor het einde van de rust komen
         uit de plugin Local Notifications: POST_NOTIFICATIONS en SCHEDULE_EXACT_ALARM. -->

    <!-- Health Connect (docs/beslissingen/2026-11-02-health-connect.md, plugin
         @capgo/capacitor-health). ASCEND leest alleen, en alleen wat het echt gebruikt:
         trainingen, de afstand daarvan, slaap, rusthartslag, HRV, en sinds native niveau 8 ook
         gewicht en vetpercentage (docs/beslissingen/2026-11-04-gewicht-uit-health-connect.md).
         Android vraagt pas om toestemming als je Health Connect aanzet bij Instellingen,
         Koppelingen, of bij Lichaamsgewicht op Gewicht toestaan tikt. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />

    <!-- De plugin noemt in zijn eigen manifest ook alle schrijfrechten en de leesrechten voor
         gegevens die ASCEND niet gebruikt. Die gaan er bij het samenvoegen uit, zodat de app
         ze nooit kan vragen. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_VO2_MAX" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" tools:node="remove" />

    <!-- Om te zien of Health Connect op de telefoon staat (Android 13 en ouder, daar is het een
         eigen app). De plugin noemt dit ook; hier staat het zodat het niet van de plugin afhangt.
         Het scherm met de uitleg over privacy dat Health Connect eist (de activity voor
         androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE en, vanaf Android 14, de alias voor
         android.intent.action.VIEW_PERMISSION_USAGE met de categorie HEALTH_PERMISSIONS) komt uit
         het manifest van de plugin en toont public/privacypolicy.html uit de app zelf. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
