<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Back-up door Android aan, als extra vangnet naast de eigen back-up (keuze van de eigenaar,
         2 november 2026; docs/beslissingen/2026-11-01-android-app.md). Alleen de opslag van de
         webview gaat mee: res/xml/backup_rules.xml (Android 11 en ouder) en
         res/xml/data_extraction_rules.xml (Android 12 en nieuwer). -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Snelkoppelingen onder het app-icoon: res/xml/shortcuts.xml. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- De widget "Vandaag" (TodayWidgetProvider.java). -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Trillen in de webview (navigator.vibrate) en bij een melding. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- De automatische back-up schrijft in Documenten/ASCEND (plugin Filesystem,
         docs/beslissingen/2026-11-02-automatische-backup.md). Alleen Android 10 en ouder vragen
         daarvoor toestemming; vanaf Android 11 mag een app zijn eigen bestanden in Documenten zonder.
         requestLegacyExternalStorage hierboven is voor Android 10. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Je locatie (plugin Geolocation, docs/beslissingen/2026-11-02-locatie.md): alleen als je de
         instelling aanzet, en dan alleen je plek van nu. ASCEND vraagt de ruwe plek (coarse); de
         precieze staat erbij omdat de plugin hem verwacht en Android 12 en nieuwer hem als keuze
         toont. Geen achtergrondlocatie. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Meldingen (Android 13 en nieuwer) en de exacte wekker voor het einde van de rust komen
         uit de plugin Local Notifications: POST_NOTIFICATIONS en SCHEDULE_EXACT_ALARM. Health
         Connect komt later; daarvoor staat hier nog niets. -->
</manifest>
